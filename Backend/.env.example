# Plantilla de variables de entorno para Producción / Backend

# Configuración de Base de Datos PostgreSQL (Supabase / Render / ElephantSQL / Railway)
DB_USER=postgres.xxxxxxxx
DB_PASSWORD=tu_contraseña_segura
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

# URL explícita (Opcional, si no se usan las variables individuales anteriores)
# DATABASE_URL=postgresql://usuario:contraseña@host:6543/postgres

# Seguridad y CORS (Dominios del frontend separados por coma)
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-dominio.com

# Puerto (Establecido automáticamente por plataformas PaaS como Render o Railway)
PORT=8000

